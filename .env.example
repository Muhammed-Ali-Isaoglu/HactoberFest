OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# Reader role created by db/init/000_reader_role.sh. Replace the password locally.
DATABASE_URL=postgresql://actiongate_reader:change_me@127.0.0.1:5433/actiongate_demo
DEMO_OPERATOR_TOKEN=replace_me_locally
TASK_TTL_SECONDS=900
MAX_AGENT_STEPS=6
MAX_TASK_QUERIES=10
MAX_ROWS_PER_QUERY=100
OUTBOX_MODE=local
ACTIONGATE_DB_PATH=data/actiongate.sqlite3
# Used only by docker compose to create the admin and reader roles locally.
POSTGRES_ADMIN_PASSWORD=change_me_admin
ACTIONGATE_READER_PASSWORD=change_me
